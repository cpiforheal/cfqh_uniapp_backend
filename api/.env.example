PORT=3001
NODE_ENV=development
DATABASE_URL=file:./dev.db
ADMIN_TOKEN=cfqh-admin-dev-token
GATEWAY_SECRET=replace-with-shared-gateway-secret
# 仅本地直连/测试云环境启用；预发布和生产应设为 false，并清空 DEV_OPEN_ID
ALLOW_DEV_OPEN_ID=true
DEV_OPEN_ID=dev-open-id-local
# 小程序 AppID 可与微信开发者工具 project.config.json 保持一致；AppSecret 只放在服务端环境变量
WECHAT_APP_ID=wx9fa36f92c1775f62
WECHAT_APP_SECRET=

# 腾讯云 VOD Web 直传签名（视频上传用）
TENCENT_SECRET_ID=replace-with-tencent-secret-id
TENCENT_SECRET_KEY=replace-with-tencent-secret-key
TENCENT_VOD_SUB_APP_ID=
TENCENT_VOD_PROCEDURE=
TENCENT_VOD_STORAGE_REGION=
TENCENT_VOD_CLASS_ID=
TENCENT_VOD_EXPIRE_SECONDS=3600
