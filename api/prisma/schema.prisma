generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum LicenseStatus {
  unused
  bound
  disabled
  expired
}

enum ContentStatus {
  draft
  published
  offline
}

enum SubjectCode {
  nursing
  math
  study_card
}

enum AdminRole {
  super_admin
  teacher
}

enum AdminUserStatus {
  active
  disabled
}

enum QuestionType {
  single_choice
  multiple_choice
  judgment
  short_answer
  case_analysis
}

model User {
  id              String             @id @default(cuid())
  openId          String             @unique
  nickname        String?
  avatarUrl       String?
  remark          String?
  realName        String?
  className       String?
  phoneTail       String?
  wechatId        String?
  loginCount      Int                @default(0)
  lastLoginAt     DateTime?
  lastClientEnv   String?
  lastPlatform    String?
  lastDevice      String?
  lastSdkVersion  String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  authorization   UserAuthorization?
  studyCardAuth   StudyCardAuthorization?
  practiceRecords  PracticeRecord[]
  favorites        Favorite[]
  mistakes         Mistake[]
  loginLogs        UserLoginLog[]
  activationAttempts LicenseActivationAttempt[]
  videoPlayRecords VideoPlayRecord[] @relation("VideoPlayRecords")
  examSessions     ExamSession[]
}

model UserLoginLog {
  id         String   @id @default(cuid())
  userId     String
  openId     String
  nickname   String?
  clientEnv  String?
  platform   String?
  device     String?
  sdkVersion String?
  appVersion String?
  source     String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([openId])
  @@index([createdAt])
}

model LicenseToken {
  id            String              @id @default(cuid())
  code          String              @unique
  status        LicenseStatus       @default(unused)
  subjectScope  SubjectCode         @default(nursing)
  resourceScope String              @default("all")
  maxBindCount  Int                 @default(1)
  groupTag      String?
  boundUserId   String?
  boundOpenId   String?
  boundAt       DateTime?
  expiresAt     DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  authorization UserAuthorization[]
  studyCardAuth StudyCardAuthorization?
  activationAttempts LicenseActivationAttempt[]
}

model LicenseActivationAttempt {
  id             String        @id @default(cuid())
  codeInput      String
  codeNormalized String?
  tokenId        String?
  userId         String?
  openId         String
  result         String
  reason         String
  tokenStatus    String?
  clientEnv      String?
  platform       String?
  device         String?
  sdkVersion     String?
  appVersion     String?
  source         String?
  ip             String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  user           User?         @relation(fields: [userId], references: [id])
  licenseToken   LicenseToken? @relation(fields: [tokenId], references: [id])

  @@index([openId])
  @@index([tokenId])
  @@index([userId])
  @@index([reason])
  @@index([createdAt])
}

model UserAuthorization {
  id             String       @id @default(cuid())
  userId         String       @unique
  licenseTokenId String
  subjectScope   SubjectCode  @default(nursing)
  resourceScope  String       @default("all")
  activatedAt    DateTime     @default(now())
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id])
  licenseToken   LicenseToken @relation(fields: [licenseTokenId], references: [id])
}

model KnowledgePoint {
  id          String        @id @default(cuid())
  subjectCode SubjectCode   @default(nursing)
  name        String
  chapter     String
  sort        Int           @default(1)
  status      ContentStatus @default(draft)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Question {
  id            String        @id @default(cuid())
  subjectCode   SubjectCode   @default(nursing)
  moduleCode    String        @default("anatomy")
  moduleName    String        @default("人体解剖学")
  chapter       String        @default("待补充小章节")
  chapterSort   Int           @default(1)
  title         String
  stem          String
  type          QuestionType
  difficulty    String
  knowledgeTags String
  optionsJson   String        @default("[]")
  answer        String
  analysis      String
  source        String?
  status        ContentStatus @default(draft)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  mistakes      Mistake[]
}

model CaseMaterial {
  id                   String        @id @default(cuid())
  subjectCode          SubjectCode   @default(nursing)
  title                String
  background           String
  keywords             String
  relatedKnowledgeTags String
  analysisFocus        String
  status               ContentStatus @default(draft)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model ConfusingPoint {
  id              String        @id @default(cuid())
  subjectCode     SubjectCode   @default(nursing)
  title           String
  leftConcept     String
  rightConcept    String
  contrastSummary String
  status          ContentStatus @default(draft)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model MemoryTip {
  id                   String        @id @default(cuid())
  subjectCode          SubjectCode   @default(nursing)
  title                String
  tip                  String
  relatedKnowledgeTags String
  status               ContentStatus @default(draft)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model VideoLesson {
  id            String        @id @default(cuid())
  subjectCode   SubjectCode   @default(nursing)
  moduleCode    String        @default("anatomy")
  moduleName    String        @default("人体解剖学")
  chapter       String        @default("待补充小章节")
  title         String
  duration      Int
  difficulty    String
  knowledgeTags String
  coverUrl      String?
  assetKey      String?
  videoUrl      String?
  status        ContentStatus @default(draft)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model VideoAsset {
  id          String        @id @default(cuid())
  subjectCode SubjectCode   @default(nursing)
  filename    String
  fileKey     String        @unique
  sizeMB      Float         @default(0)
  source      String        @default("local")
  downloadUrl String?
  status      ContentStatus @default(draft)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model DailyPractice {
  id            String        @id @default(cuid())
  subjectCode   SubjectCode   @default(nursing)
  date          DateTime
  questionId    String
  questionTitle String
  knowledgeTags String
  status        ContentStatus @default(draft)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model PracticeRecord {
  id              String   @id @default(cuid())
  userId          String
  questionId      String
  submittedAnswer String?
  selectedOption  String?
  isCorrect       Boolean
  practiceMode    String   @default("daily")
  sequenceNo      Int?
  totalCount      Int?
  durationMs      Int?
  sessionId       String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([questionId])
  @@index([sessionId])
  @@index([createdAt])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, questionId])
}

model Mistake {
  id             String    @id @default(cuid())
  userId         String
  questionId     String
  wrongCount     Int       @default(1)
  lastWrongAt    DateTime?
  nextReviewAt   DateTime?
  selectedOption String?
  mastered       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id])
  question       Question  @relation(fields: [questionId], references: [id])

  @@unique([userId, questionId])
  @@index([userId])
  @@index([nextReviewAt])
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model VideoPlayRecord {
  id              String   @id @default(cuid())
  userId          String
  videoId         String
  watchDurationMs Int?
  progress        Float?
  createdAt       DateTime @default(now())
  user            User     @relation("VideoPlayRecords", fields: [userId], references: [id])

  @@index([userId])
  @@index([videoId])
}

model AdminAuditLog {
  id         String     @id @default(cuid())
  action     String
  target     String?
  detail     String?
  operatorId String?
  operator   String     @default("admin")
  ip         String?
  createdAt  DateTime   @default(now())
  adminUser  AdminUser? @relation(fields: [operatorId], references: [id])

  @@index([createdAt])
  @@index([action])
  @@index([operatorId])
}

model AdminUser {
  id           String          @id @default(cuid())
  username     String          @unique
  passwordHash String
  role         AdminRole       @default(teacher)
  status       AdminUserStatus @default(active)
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sessions     AdminSession[]
  auditLogs    AdminAuditLog[]

  @@index([role])
  @@index([status])
}

model AdminSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  adminUserId String
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([expiresAt])
}

// ─── Online Exam Module ───────────────────────────────────────────────────────

enum ExamStatus {
  draft
  open
  grading
  published
}

enum ExamSessionStatus {
  in_progress
  submitted
  graded
}

model Exam {
  id          String      @id @default(cuid())
  title       String
  description String?
  subjectCode SubjectCode @default(nursing)
  durationMin Int
  totalScore  Float
  maxStudents Int         @default(100)
  status      ExamStatus  @default(draft)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  questions   ExamQuestion[]
  licenses    ExamLicense[]
  sessions    ExamSession[]
}

model ExamQuestion {
  id          String       @id @default(cuid())
  examId      String
  seq         Int
  type        QuestionType
  stem        String
  optionsJson String       @default("[]")
  answer      String
  analysis    String?
  score       Float
  isObjective Boolean      @default(true)
  createdAt   DateTime     @default(now())
  exam        Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers     ExamAnswer[]

  @@index([examId])
}

model ExamLicense {
  id          String       @id @default(cuid())
  code        String       @unique
  examId      String
  boundUserId String?
  boundOpenId String?
  boundAt     DateTime?
  createdAt   DateTime     @default(now())
  exam        Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  session     ExamSession?

  @@index([examId])
}

model ExamSession {
  id              String            @id @default(cuid())
  examId          String
  userId          String
  licenseId       String            @unique
  startedAt       DateTime          @default(now())
  submittedAt     DateTime?
  status          ExamSessionStatus @default(in_progress)
  objectiveScore  Float?
  subjectiveScore Float?
  totalScore      Float?
  rank            Int?
  hideCount       Int               @default(0)
  hideDurationMs  Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  exam            Exam              @relation(fields: [examId], references: [id])
  user            User              @relation(fields: [userId], references: [id])
  license         ExamLicense       @relation(fields: [licenseId], references: [id])
  answers         ExamAnswer[]
  comment         ExamComment?

  @@index([examId])
  @@index([userId])
}

model ExamAnswer {
  id         String       @id @default(cuid())
  sessionId  String
  questionId String
  answer     String?
  isCorrect  Boolean?
  score      Float?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  session    ExamSession  @relation(fields: [sessionId], references: [id])
  question   ExamQuestion @relation(fields: [questionId], references: [id])

  @@unique([sessionId, questionId])
}

model ExamComment {
  id        String      @id @default(cuid())
  sessionId String      @unique
  content   String
  createdBy String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  session   ExamSession @relation(fields: [sessionId], references: [id])
}

// ─── Study Card Module ────────────────────────────────────────────────────────

model StudyCardModule {
  id         String              @id @default(cuid())
  moduleCode String              @unique
  moduleName String
  sort       Int                 @default(1)
  status     ContentStatus       @default(published)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  questions  StudyCardQuestion[]
}

model StudyCardQuestion {
  id             String                   @id @default(cuid())
  moduleId       String
  seq            Int
  stem           String
  type           QuestionType             @default(single_choice)
  optionsJson    String                   @default("[]")
  answer         String
  status         ContentStatus            @default(published)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  module         StudyCardModule          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  knowledgeCards StudyCardKnowledgeCard[]

  @@index([moduleId])
}

model StudyCardKnowledgeCard {
  id         String            @id @default(cuid())
  questionId String
  seq        Int
  title      String
  bodyJson   String
  createdAt  DateTime          @default(now())
  question   StudyCardQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model StudyCardMastery {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  mastered   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, questionId])
  @@index([userId])
}

model StudyCardAuthorization {
  id         String       @id @default(cuid())
  userId     String       @unique
  openId     String       @unique
  tokenId    String       @unique
  expiresAt  DateTime
  createdAt  DateTime     @default(now())
  user       User         @relation(fields: [userId], references: [id])
  token      LicenseToken @relation(fields: [tokenId], references: [id])
}
