{
  "name": "cfqh-procedure-miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "专转本医护大类自学辅助微信小程序",
  "scripts": {
    "dev:weapp": "CFQH_LOCAL_TARGET=devtools node scripts/weapp-local-dev.mjs --watch",
    "dev:weapp:local": "node scripts/weapp-local-dev.mjs --watch",
    "dev:weapp:devtools": "CFQH_LOCAL_TARGET=devtools node scripts/weapp-local-dev.mjs --watch",
    "dev:weapp:cloud": "taro build --type weapp --watch",
    "dev:api": "pnpm --dir api run start:dev",
    "build:weapp": "taro build --type weapp",
    "build:weapp:local": "node scripts/weapp-local-dev.mjs",
    "build:weapp:devtools": "CFQH_LOCAL_TARGET=devtools node scripts/weapp-local-dev.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:preflight:prod": "node scripts/release-preflight.mjs --production --strict-git",
    "check:miniapp-dist": "node scripts/check-miniapp-dist.mjs",
    "check:miniapp-local-dist": "node scripts/check-miniapp-local-dist.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tarojs/components": "^4.0.9",
    "@tarojs/helper": "^4.0.9",
    "@tarojs/plugin-framework-react": "^4.0.9",
    "@tarojs/plugin-platform-weapp": "^4.0.9",
    "@tarojs/react": "^4.0.9",
    "@tarojs/runtime": "^4.0.9",
    "@tarojs/shared": "^4.0.9",
    "@tarojs/taro": "^4.0.9",
    "@tanstack/react-query": "^5.90.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@tarojs/cli": "^4.0.9",
    "@tarojs/taro-loader": "^4.0.9",
    "@tarojs/webpack5-runner": "^4.0.9",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "babel-preset-taro": "^4.0.9",
    "eslint": "^9.39.1",
    "eslint-config-taro": "^4.0.9",
    "sass": "^1.94.2",
    "stylelint": "^16.26.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.18.3"
}
